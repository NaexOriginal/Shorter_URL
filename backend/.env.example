APP_NAME="Shorter URL API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://shorter:shorter@localhost:5432/shorter_url
REDIS_URL=redis://localhost:6379/0

# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-me-this-is-not-secure-32b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Free download (requires a MaxMind account) from:
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# If the file isn't present, geo lookups just return null (no error).
GEOIP_DB_PATH=geoip/GeoLite2-City.mmdb
